*.db
*.db-wal
*.db-shm
data/
data-dev/
portable.txt

# --- Secrets (C28: API keys must never be plaintext in repo) ---
.env
.env.*
*.pem
*.p12
*.pfx
secrets/

# --- Test outputs ---
*.prof
coverage*
testdata/local/

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
