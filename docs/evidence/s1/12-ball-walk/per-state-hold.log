########## Sleeping
balldebug: start handles=125
balldebug: hotkeys live=4/4 summon=Ctrl+Alt+Q live
  mute=Ctrl+Alt+M live
  cancel=Esc live
  panel=Ctrl+Alt+P live
balldebug: ball up handles=380
balldebug: state=Sleeping handles=380 timers=false
balldebug: closed handles=381
balldebug: OK
exit=0
