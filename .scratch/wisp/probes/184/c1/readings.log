   371	func (b *Bridge) route(ctx context.Context, dec *Decision, sil risk.Silenced) (bool, string) {
   372		switch sil.Level {
   373		case risk.L0:
   374			dec.DecisionColumn = agent.DecisionAllow
   375			return true, ""
   376	
   377		case risk.Deny:
   378			dec.DecisionColumn = agent.DecisionReject
   379			return false, "该目标被绝对禁止访问（R3 A 档，任何授权都不可豁免）：" + dec.Reason
   380	
   381		case risk.L1:
   382			a, why := b.gate.PendingWindow(ctx, *dec)
   383			switch a {
   384			case AnswerAllow, AnswerTimeout:
   385				// The L1 window running out unopposed MEANS EXECUTE (SPEC-06 §2).
   386				dec.DecisionColumn = agent.DecisionAllow
   387				return true, ""
   388			case AnswerVeto:
   389				dec.DecisionColumn = agent.DecisionReject
   390				return false, orDefault(why, "用户在 L1 确认窗口中否决了本次操作")
   391			default:
   392				dec.DecisionColumn = agent.DecisionReject
   393				return false, orDefault(why, "L1 确认窗口未放行，已拒绝执行")
   394			}
   395	
   396		case risk.L2:
   397			a, why := b.gate.PendingApproval(ctx, *dec)
   398			switch a {
   399			case AnswerAllow:
   400				dec.DecisionColumn = agent.DecisionAllow
   401				return true, ""
   402			case AnswerTimeout:
   403				// The queue never waits forever: an unanswered L2 auto-REJECTS
   404				// (ticket 21), deliberately the opposite polarity from L1.
   405				dec.DecisionColumn = agent.DecisionTimeout
   406				return false, orDefault(why, "审批超时未确认，已自动拒绝")
   407			default:
   408				dec.DecisionColumn = agent.DecisionReject
   409				return false, orDefault(why, "L2 审批未通过，已拒绝执行")
   410			}
   411	
   412		default:
   413			// An impossible level means a broken judge: fail closed (R9's posture).
   414			dec.DecisionColumn = agent.DecisionReject
   415			return false, "风险判定返回了不可能的等级，已 fail-closed 拒绝"
   416		}

### CMD: git show HEAD:internal/agent/loop.go | nl -ba | sed -n '783,806p'
   783	func (l *Loop) decideRisk(ctx context.Context, j *taskJournal, rowID int64, info ToolInfo) (ok, unbooked bool, why string) {
   784		risk := info.RiskLevel
   785		switch risk {
   786		case RiskL1, RiskL2:
   787			if l.opt.AdmitTask == nil {
   788				j.decide(ctx, rowID, DecisionReject)
   789				return false, false, "该操作属于 " + risk + " 级，审批通道尚未接入（ticket 21），已拒绝执行"
   790			}
   791			return true, true, ""
   792		case RiskL0:
   793			// A declared tier, the lowest one: run it, interrupt nobody (D4).
   794			j.decide(ctx, rowID, DecisionAllow)
   795			return true, false, ""
   796		default:
   797			// Reached only by RiskUnclassified ("") and by anything the directory
   798			// declares no tier for; both fail closed while the switch is off.
   799			if !l.opt.Config.PassThroughUnclassifiedRisk {
   800				j.decide(ctx, rowID, DecisionReject)
   801				return false, false, "风险未分级且直通开关关闭，已拒绝执行"
   802			}
   803			j.decide(ctx, rowID, DecisionAllow)
   804			return true, false, ""
   805		}
   806	}

