### RULER 1: literal codepoint roster in the ANCHOR version of isDisplayWashCf
func isDisplayWashCf(r rune) bool {
	switch r {
	case 0x00AD,
		0x200B, 0x200C, 0x200D,
		0x2060, 0xFEFF,
		0x202A, 0x202B, 0x202C, 0x202D, 0x202E,
		0x2066, 0x2067, 0x2068, 0x2069:
		return true
	default:
		return false
	}
}
