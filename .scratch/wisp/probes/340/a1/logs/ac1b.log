   333	func splitClashSuffix(id string) (base string, ok bool) {
   334		i := strings.LastIndexByte(id, '#')
   335		if i <= 0 || i == len(id)-1 {
   336			return "", false
   337		}
   338		for _, r := range id[i+1:] {
   339			if r < '0' || r > '9' {
   340				return "", false
   341			}
   342		}
   343		return id[:i], true
   344	}
