### 4. push 撞名支的完整字节（含两枚操作数与空 corr 回退，丙形看不见的语义在这一段）
   154	// push admits one decision into the queue and assigns the correlation id the
   155	// reply is routed by (C18). Overflow fails closed.
   156	func (q *Queue) push(d tools.Decision) (*qitem, error) {
   157		q.mu.Lock()
   158		defer q.mu.Unlock()
   159		if len(q.pending) >= q.maxPend {
   160			return nil, fmt.Errorf("审批队列已满（%d 项待决），无法登记新的 L2 请求，已 fail-closed 拒绝", q.maxPend)
   161		}
   162		q.seq++
   163		corr := d.CorrelationID
   164		if corr == "" {
   165			corr = "approval-" + strconv.FormatUint(q.seq, 10)
   166		}
   167		if _, clash := q.byID[corr]; clash {
   168			corr = fmt.Sprintf("%s#%d", d.CorrelationID, q.seq)
   169		}
   170		it := &qitem{
   171			Dec: d, Corr: corr, Seq: q.seq,
   172			names:  otherNames(d, corr),
   173			grants: newGrantStore(),
   174			state:  statePending,
   175			answer: make(chan answer, 1),
   176		}
   177		it.bind = bindDigest(corr, d.TaskID, d.Tool, d.LevelString(), q.seq, d.Args)
   178		q.pending = append(q.pending, it)
   179		q.byID[corr] = it
   180		q.indexLocked(it)
   181		q.logf("approval: queued corr=%s task=%s tool=%s depth=%d",
   182			corr, d.TaskID, d.Tool, len(q.pending))
   183		return it, nil
   184	}
-- callCorr 两臂格式串逐字（铸造侧的另一枚 #）
   603	func callCorr(taskID, callID string, index int) string {
   604		if callID == "" {
   605			return fmt.Sprintf("%s#call-%d", taskID, index)
   606		}
   607		return taskID + "#" + callID
   608	}

### 5. 臂承重名册的原料（⛔ 本腿跑，只逐枚点名表项与两枚臂的字节判据）
