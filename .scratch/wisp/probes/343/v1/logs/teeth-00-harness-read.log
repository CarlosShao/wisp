5:# three pre-existing instruments, then restore. Judge-run; own tree, own GOTMPDIR.
12:TREE="${TREE:?exported tree root}"
14:GOTMPROOT="${GOTMPROOT:?D-volume gotmp root}"
15:F="$TREE/internal/risk/blacklist.go"
17:export GOPATH='D:\work\base\gopath'
18:export PATH="$TREE/third_party/sherpa-onnx:$TREE/build:$PATH"
29:  local gt="$GOTMPROOT/$2"; mkdir -p "$gt" || { echo "  mkdir_gotmp_rc=NONZERO"; return 1; }
