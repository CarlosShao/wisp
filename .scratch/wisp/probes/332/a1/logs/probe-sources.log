// 332-a1 起手尺②探针：独立复跑「全标量 unicode.Is(unicode.Cf, r) 枚数」。
// 纯 stdlib、⛔ import 本仓任何包、⛔ 本仓包参与编译。唯一执行过的代码＝本枚文件。
//
// 下面四个函数（isDisplayWashCf / writeControlEscape / scrubForDisplay /
// needsDisplayWash）是从具名提交树 7535d83b 的
// internal/panel/display_scrub_216.go 第 106-136、164-175、179-199、211-220 行
// **逐字重打**（函数体一字未改，仅 package 头与注释换成本文件）。
package main

import (
	"fmt"
	"strings"
	"unicode"
	"unicode/utf8"
)

// ---- 逐字重打自 display_scrub_216.go:164-175 ----
func isDisplayWashCf(r rune) bool {
	switch r {
	case 0x00AD,
		0x200B, 0x200C, 0x200D,
		0x2060, 0xFEFF,
		0x202A, 0x202B, 0x202C, 0x202D, 0x202E,
		0x2066, 0x2067, 0x2068, 0x2069:
		return true
	default:
		return false
	}
}

// ---- 逐字重打自 display_scrub_216.go:179-199 ----
func writeControlEscape(b *strings.Builder, r rune) {
	switch r {
	case '\n':
		b.WriteString(`\n`)
	case '\r':
		b.WriteString(`\r`)
	case '\t':
		b.WriteString(`\t`)
	case '\x00':
		b.WriteString(`\0`)
	default:
		if r <= 0xff {
			fmt.Fprintf(b, `\x%02x`, r)
			return
		}
		fmt.Fprintf(b, `\u%04x`, r)
	}
}

// ---- 逐字重打自 display_scrub_216.go:106-136 ----
func scrubForDisplay(s string) string {
	if !needsDisplayWash(s) {
		return s
	}
	var b strings.Builder
	b.Grow(len(s) + 16)
	for i := 0; i < len(s); {
		r, size := utf8.DecodeRuneInString(s[i:])
		switch {
		case r == utf8.RuneError && size == 1:
			fmt.Fprintf(&b, `\x%02x`, s[i])
			i++
		case unicode.IsControl(r):
			writeControlEscape(&b, r)
			i += size
		case isDisplayWashCf(r):
			writeControlEscape(&b, r)
			i += size
		default:
			b.WriteRune(r)
			i += size
		}
	}
	return b.String()
}

// ---- 逐字重打自 display_scrub_216.go:211-220 ----
func needsDisplayWash(s string) bool {
	for i := 0; i < len(s); {
		r, size := utf8.DecodeRuneInString(s[i:])
		if (r == utf8.RuneError && size == 1) || unicode.IsControl(r) || isDisplayWashCf(r) {
			return true
		}
		i += size
	}
	return false
}

func main() {
	fmt.Printf("GO_UNICODE_VERSION=%s\n", unicode.Version)
	total := 0
	washed := 0
	var lines []string
	for r := rune(0); r <= utf8.MaxRune; r++ {
		if r >= 0xD800 && r <= 0xDFFF { // ⛔ 代理区：不是标量值
			continue
		}
		if !unicode.Is(unicode.Cf, r) {
			continue
		}
		total++
		inRoster := isDisplayWashCf(r)
		if inRoster {
			washed++
		}
		// 逐枚自证：把单独一枚 Cf 送进 scrubForDisplay，看它是否被换成可见转义形。
		single := string(r)
		out := scrubForDisplay(single)
		changed := out != single
		mark := "RAW"
		if changed {
			mark = "WASHED"
		}
		tag := "N"
		if inRoster {
			tag = "Y"
		}
		// 一致性自证：名单判定 ⇄ 实际行为 必须一致，否则这枚读数不可用。
		consist := "OK"
		if inRoster != changed {
			consist = "MISMATCH"
		}
		lines = append(lines, fmt.Sprintf("%04X\tcat=Cf\troster=%s\tout=%q\t%s\t%s", r, tag, out, mark, consist))
	}
	fmt.Printf("CF_TOTAL=%d\n", total)
	fmt.Printf("CF_IN_ROSTER=%d\n", washed)
	fmt.Printf("CF_OUTSIDE_ROSTER=%d\n", total-washed)
	// 名单里但不是 Cf 的枚数（应为 0，除 U+00AD 之外都在 Cf；U+00AD 是 Cf，验证）
	nonCfInRoster := 0
	for _, r := range []rune{0x00AD, 0x200B, 0x200C, 0x200D, 0x2060, 0xFEFF, 0x202A, 0x202B, 0x202C, 0x202D, 0x202E, 0x2066, 0x2067, 0x2068, 0x2069} {
		if !unicode.Is(unicode.Cf, r) {
			nonCfInRoster++
			fmt.Printf("ROSTER_RUNE_NOT_CF=%04X\n", r)
		}
	}
	fmt.Printf("ROSTER_SIZE=15 ROSTER_NOT_CF=%d\n", nonCfInRoster)
	fmt.Println("--- ROSTER BEGIN ---")
	for _, l := range lines {
		fmt.Println(l)
	}
	fmt.Println("--- ROSTER END ---")
	// MISMATCH 计数（必须为 0 才能用这张表当读数）
	mism := 0
	for _, l := range lines {
		if strings.Contains(l, "MISMATCH") {
			mism++
		}
	}
	fmt.Printf("MISMATCH_COUNT=%d\n", mism)
}
