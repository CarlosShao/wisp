V1SHAPE chain:case1-gitcreds class=A allow=false needL2=false rule=A:~-.git-credentials
V1SHAPE chain:case3-wisp-config class=A allow=false needL2=false rule=A:%APPDATA%-wisp-config.toml
V1SHAPE chain:case4-ssh class=A allow=false needL2=false rule=A:~-.aws-credentials
V1SHAPE chain:case5-aws class=A allow=false needL2=false rule=A:~-.aws-credentials
V1SHAPE chain:case6-kube class=A allow=false needL2=false rule=A:~-.kube-config
V1SHAPE chain:case8-dpapi class=A allow=false needL2=false rule=A:%APPDATA%-wisp-config.toml
V1SHAPE chain:case9-local-creds class=A allow=false needL2=false rule=A:Microsoft-Credentials
V1SHAPE chain:case4b-ssh-solo class=B allow=false needL2=true rule=B-tier
V1SHAPE chain:case8b-dpapi-solo class=A allow=false needL2=false rule=A:Microsoft-Protect
V1SHAPE offchain:case1-gitcreds class=B allow=false needL2=true rule=B-tier
V1SHAPE offchain:case3-wisp-config class=B allow=false needL2=true rule=B-tier
V1SHAPE offchain:case4-ssh class=B allow=false needL2=true rule=B-tier
V1SHAPE offchain:case5-aws class=B allow=false needL2=true rule=B-tier
V1SHAPE offchain:case6-kube class=B allow=false needL2=true rule=B-tier
V1SHAPE offchain:case8-dpapi class=B allow=false needL2=true rule=B-tier
V1SHAPE offchain:case9-local-creds class=B allow=false needL2=true rule=B-tier
V1SHAPE offchain:case4b-ssh-solo class=B allow=false needL2=true rule=B-tier
V1SHAPE offchain:case8b-dpapi-solo class=B allow=false needL2=true rule=B-tier
