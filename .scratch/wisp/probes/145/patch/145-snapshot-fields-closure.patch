@@ -0,0 +1,37 @@
+package panel
+
+import (
+	"encoding/json"
+	"testing"
+	"time"
+
+	"github.com/CarlosShao/wisp/internal/risk"
+)
+
+// probe: assemble EXACTLY what cmd/wisp/run.go:421-427 assembles today (five
+// readers, none of them a new one) and report what the five new sections come
+// out as. This is the "无生产者" reading of ticket 145's candidate set.
+func TestProbe145WhatTheLiveAssemblyFills(t *testing.T) {
+	p := NewSnapshotPump(PumpSources{
+		Verdicts: func() []NativeVerdict {
+			return []NativeVerdict{{CorrelationID: "c1", Tool: "fs.write",
+				Args: []string{"a.txt"}, Level: risk.Level(2)}}
+		},
+		Mode:      func() risk.Mode { return risk.Mode(1) },
+		Workspace: func() WorkspaceView { return WorkspaceView{Set: true, Canonical: "D:/x"} },
+		Results:   func() []ResultChunk { return []ResultChunk{{CorrelationID: "t1", Text: "hi"}} },
+		Now:       func() time.Time { return time.Date(2026, 9, 26, 9, 0, 0, 0, time.UTC) },
+	})
+	snap := p.Snapshot()
+	b, err := json.Marshal(snap.Run)
+	t.Logf("run        = %s err=%v", b, err)
+	b, _ = json.Marshal(snap.Tools)
+	t.Logf("tools      = %s", b)
+	b, _ = json.Marshal(snap.Approval)
+	t.Logf("approval   = %s", b)
+	b, _ = json.Marshal(snap.Cost)
+	t.Logf("cost       = %s", b)
+	b, _ = json.Marshal(snap.Failures)
+	t.Logf("failures   = %s", b)
+	t.Logf("pending len=%d results len=%d (both live)", len(snap.Pending), len(snap.Results))
+}
