+// liveGateState reports the gate section off the objects this process already
+// runs: the L1 window the gate was built with, and the channel registry's own
+// availability lines (B1's verbatim wording, copied not re-worded).
+func (rt *agentRuntime) liveGateState() panel.ApprovalState {
+	st := panel.ApprovalState{Channels: []panel.VetoChannelView{}}
+	if rt == nil || rt.gate == nil {
+		return st
+	}
+	st.WindowMs = rt.gate.Window().Milliseconds()
+	for _, c := range rt.gate.Channels().Statuses() {
+		st.Channels = append(st.Channels, panel.VetoChannelView{
+			Name: string(c.Channel), Text: c.Text, Loaded: c.Loaded,
+		})
+	}
+	return st
+}
+
