diff --git a/cmd/wisp/panel_pump_gate145_test.go b/cmd/wisp/panel_pump_gate145_test.go
new file mode 100644
index 0000000..efa6df8
--- /dev/null
+++ b/cmd/wisp/panel_pump_gate145_test.go
@@ -0,0 +1,77 @@
+package main
+
+// MEASUREMENT ONLY - this file lives in an out-of-repo copy (D:\tmp\wisp145-e1)
+// and is ticket 145's AC#6 witness for the candidate gate section: it asks
+// whether the new approval.* values arrive from objects the run is actually
+// running, and it is the case that must go red when the fill is removed.
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/CarlosShao/wisp/internal/panel"
+)
+
+type chanRow struct {
+	name   string
+	text   string
+	loaded bool
+}
+
+func TestSnapshotGateSectionComesFromTheLiveGate(t *testing.T) {
+	f := newRunFixture(t, "openai-chat")
+	var (
+		live    panel.Snapshot
+		gateWin int64
+		rows    []chanRow
+	)
+	f.rtHook = func(rt *agentRuntime) {
+		gateWin = rt.gate.Window().Milliseconds()
+		for _, c := range rt.gate.Channels().Statuses() {
+			rows = append(rows, chanRow{string(c.Channel), c.Text, c.Loaded})
+		}
+		rt.publishPanelSnapshot()
+		live, _, _ = rt.lastPanelSnapshot()
+	}
+	if code := f.run("总结一下 这份笔记"); code != 0 {
+		t.Fatalf("exit %d\nstderr:\n%s", code, f.err.String())
+	}
+	b, _ := json.Marshal(live.Approval)
+	t.Logf("packet approval section = %s", b)
+	t.Logf("gate window=%dms registry rows=%+v", gateWin, rows)
+
+	if len(rows) != 4 {
+		t.Fatalf("the live registry reported %d channels, want the four allChannels names", len(rows))
+	}
+	if live.Approval.Depth != 0 {
+		t.Errorf("depth = %d, want the queue's real emptiness", live.Approval.Depth)
+	}
+	if live.Approval.WindowMs != gateWin {
+		t.Errorf("windowMs = %d, want the gate's own %d", live.Approval.WindowMs, gateWin)
+	}
+	if live.Approval.WindowMs == 0 {
+		t.Error("windowMs = 0: the section arrived unfilled")
+	}
+	if len(live.Approval.Channels) != len(rows) {
+		t.Fatalf("packet carries %d channel rows, registry reports %d",
+			len(live.Approval.Channels), len(rows))
+	}
+	for i, want := range rows {
+		got := live.Approval.Channels[i]
+		if got.Name != want.name || got.Text != want.text || got.Loaded != want.loaded {
+			t.Errorf("row %d = %+v, want %+v as the registry itself words it", i, got, want)
+		}
+	}
+	// B1's mandated line must survive the copy into the packet verbatim.
+	for _, c := range live.Approval.Channels {
+		if c.Name != "kws" {
+			continue
+		}
+		if c.Loaded {
+			t.Error("kws reported loaded: the packet would promise a voice cancel that cannot fire")
+		}
+		if c.Text != "说取消词：语音取消不可用" {
+			t.Errorf("kws text = %q, want B1's verbatim sentence", c.Text)
+		}
+	}
+}
diff --git a/internal/panel/probe145_carrier_test.go b/internal/panel/probe145_carrier_test.go
