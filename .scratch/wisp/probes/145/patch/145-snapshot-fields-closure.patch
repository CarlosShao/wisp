+	Text   string `json:"text"`
+	Loaded bool   `json:"loaded"`
+}
+
+// CostView is C23's cost row. Micros and Currency travel together.
+type CostView struct {
+	TokensIn     int    `json:"tokensIn"`
+	TokensOut    int    `json:"tokensOut"`
+	CachedTokens int    `json:"cachedTokens"`
+	Micros       int64  `json:"micros"`
+	Currency     string `json:"currency"`
+}
+
+// FailureView is one D37 classified failure. HumanText is NOT here: the
+// class-to-copy table does not exist in this repository (ticket 145 AC#1 乙组).
+type FailureView struct {
+	ErrorClass string `json:"errorClass"`
+	Technical  string `json:"technical"`
